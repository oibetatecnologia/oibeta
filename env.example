# Beta Platform — contrato de configuração
# Nunca exponha segredos com prefixo VITE_. Variáveis VITE_ entram no bundle do navegador.

# URL pública do frontend
VITE_APP_URL=http://localhost:3000

# Persistência do backend: json | supabase
# Fallback local do frontend: auto | enabled | disabled
VITE_PERSISTENCE_FALLBACK_MODE=auto
DATABASE_MODE=json
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Segurança e IA — somente backend
AI_ENCRYPTION_KEY=
AI_GATEWAY_KEY=

# Integrações públicas/proxies
VITE_PNCP_BASE_URL=
VITE_COMPRAS_GOV_BASE_URL=
VITE_AI_GATEWAY_URL=

# Cloudflare R2
VITE_R2_PUBLIC_BASE_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ACCOUNT_ID=

# URL interna do backend, quando aplicável
APP_URL=http://localhost:3000

# PNCP Radar connector (optional)
# Comma-separated PNCP modality codes. Defaults to 4,5,6,7,8,9,12.
PNCP_MODALITY_CODES=4,5,6,7,8,9,12

# Background notification schedulers. Keep disabled in local development.
ENABLE_BACKGROUND_SCHEDULERS=false
